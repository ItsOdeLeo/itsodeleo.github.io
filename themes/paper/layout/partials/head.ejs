<% const seo = seoMetadata(); const alternates = seoTranslations(); %>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= seo.title %></title>
<meta name="description" content="<%= seo.description %>">
<meta name="author" content="<%= config.author %>">
<meta name="robots" content="<%= seo.robots %>">
<link rel="canonical" href="<%= seo.canonical %>">
<% alternates.forEach(function(alternate) { %>
<link rel="alternate" hreflang="<%= alternate.lang %>" href="<%= alternate.url %>">
<% }); %>
<meta property="og:title" content="<%= seo.title %>">
<meta property="og:description" content="<%= seo.description %>">
<meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
<meta property="og:url" content="<%= seo.canonical %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:locale" content="<%= seo.locale %>">
<% alternates.filter(alternate => alternate.lang !== seo.lang).forEach(function(alternate) { %>
<meta property="og:locale:alternate" content="<%= alternate.lang === 'zh' ? 'zh_CN' : 'en_US' %>">
<% }); %>
<% if (seo.published) { %>
<meta property="article:published_time" content="<%= seo.published %>">
<meta property="article:modified_time" content="<%= seo.modified %>">
<% } %>
<meta name="twitter:card" content="<%= seo.image ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= seo.title %>">
<meta name="twitter:description" content="<%= seo.description %>">
<% if (seo.image) { %>
<meta property="og:image" content="<%= seo.image %>">
<meta name="twitter:image" content="<%= seo.image %>">
<% if (seo.imageAlt) { %>
<meta property="og:image:alt" content="<%= seo.imageAlt %>">
<meta name="twitter:image:alt" content="<%= seo.imageAlt %>">
<% } %>
<% } %>
<% if (config.seo && config.seo.google_site_verification) { %>
<meta name="google-site-verification" content="<%= config.seo.google_site_verification %>">
<% } %>
<% if (config.seo && config.seo.bing_site_verification) { %>
<meta name="msvalidate.01" content="<%= config.seo.bing_site_verification %>">
<% } %>
<script type="application/ld+json"><%- seoStructuredData(seo) %></script>
<meta name="theme-color" content="#fcfbf8">
<link rel="icon" href="data:,">
<link rel="alternate" type="application/atom+xml" title="<%= config.title %> Atom Feed" href="<%= url_for('/atom.xml') %>">
<link rel="alternate" type="application/rss+xml" title="<%= config.title %> RSS Feed" href="<%= url_for('/rss2.xml') %>">
<%- css('css/style.css') %>
