<section class="section-header">
  <div>
    <h1 data-i18n="home.title">Latest essays</h1>
    <p data-i18n="home.description">Personal essays on intelligence, simulation, and how we understand reality.</p>
  </div>
</section>
<section class="post-list" data-language-list>
  <% if (site.posts.length) { %>
    <% page.posts.sort('date', -1).each(function(post) { %>
      <%- partial('partials/post-item', { post: post }) %>
    <% }) %>
  <% } else { %>
    <p class="empty-state" data-i18n="home.empty">No posts yet. Add a Markdown file in source/_posts to get started.</p>
  <% } %>
</section>
<p class="empty-state language-empty-state" data-language-empty hidden data-i18n="filter.empty">No posts available in this language yet.</p>
<% if (page.total > 1) { %>
<nav class="pagination" aria-label="Pagination"><%- paginator() %></nav>
<% } %>
