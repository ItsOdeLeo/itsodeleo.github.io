<% const contentLanguage = page.content_language || page.lang || config.language || 'en'; -%>
<!DOCTYPE html>
<html lang="<%= page.lang || config.language || 'en' %>">
  <head>
    <%- partial('partials/head') %>
  </head>
  <body data-content-language="<%= contentLanguage %>"<% if (page.localization) { %> data-localized-collection="true"<% } %>>
    <div class="site-shell">
      <%- partial('partials/header') %>
      <main class="site-main">
        <%- partial('partials/breadcrumbs') %>
        <%- body %>
      </main>
      <%- partial('partials/footer') %>
    </div>
    <%- js('js/language-switcher.js') %>
    <% if (is_post()) { %><script src="<%= url_for('js/share.js') %>" defer></script><% } %>
  </body>
</html>
