<section class="section-header">
  <div>
    <h1><%= page.title %></h1>
    <p><%= page.description %></p>
  </div>
</section>

<% if (!page.year && !page.month) { %>
  <% let activeYear = ''; %>
  <% let activeMonth = ''; %>
  <% page.posts.sort('date', -1).each(function(post) { %>
    <% const year = date(post.date, 'YYYY'); %>
    <% const month = localizedDate(post.date, 'month'); %>
    <% const monthNumber = date(post.date, 'MM'); %>
    <% if (year !== activeYear) { %>
      <% if (activeMonth) { %>
            </ul>
          </section>
        </div>
      </section>
      <% } %>
      <section class="archive-year-block">
        <h2 class="archive-year-heading">
          <% if (config.archive_generator.yearly) { %>
          <a href="<%= url_for(localizedPath('archive') + year + '/') %>"><%= year %></a>
          <% } else { %><%= year %><% } %>
        </h2>
        <div class="archive-year-months" data-language-list>
      <% activeYear = year; %>
      <% activeMonth = ''; %>
    <% } %>
    <% if (month !== activeMonth) { %>
      <% if (activeMonth) { %>
            </ul>
          </section>
      <% } %>
      <section class="archive-month-block">
        <h3 class="archive-month-heading">
          <% if (config.archive_generator.monthly) { %>
          <a href="<%= url_for(localizedPath('archive') + year + '/' + monthNumber + '/') %>"><%= month %></a>
          <% } else { %><%= month %><% } %>
        </h3>
        <ul class="archive-posts">
      <% activeMonth = month; %>
    <% } %>
    <li class="archive-post" data-post-lang="<%= postLang(post) %>">
      <a class="archive-post-link" href="<%= url_for(post.path) %>"><%= post.title %></a>
      <div class="archive-post-meta">
        <span class="language-chip compact"><%= langLabel(postLang(post)) %></span>
        <time class="archive-post-date" datetime="<%= full_date(post.date, 'YYYY-MM-DD') %>"><%= localizedDate(post.date, 'short') %></time>
      </div>
    </li>
  <% }) %>
  <% if (page.posts.length) { %>
        </ul>
      </section>
    </div>
  </section>
  <% } else { %>
    <p class="empty-state"><%= localText('empty') %></p>
  <% } %>
<% } else { %>
  <section class="archive-filter">
    <p class="archive-filter-label">
      <% if (page.year && page.month) { %>
        <%= localizedDate(page.posts.data[0] ? page.posts.data[0].date : page.date, 'yearMonth') %>
      <% } else { %>
        <%= page.year %>
      <% } %>
    </p>
    <ul class="archive-posts" data-language-list>
      <% page.posts.sort('date', -1).each(function(post) { %>
        <li class="archive-post" data-post-lang="<%= postLang(post) %>">
          <a class="archive-post-link" href="<%= url_for(post.path) %>"><%= post.title %></a>
          <div class="archive-post-meta">
            <span class="language-chip compact"><%= langLabel(postLang(post)) %></span>
            <time class="archive-post-date" datetime="<%= full_date(post.date, 'YYYY-MM-DD') %>"><%= localizedDate(post.date) %></time>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>
<% if (page.total > 1) { %>
<nav class="pagination" aria-label="<%= localText('pagination.label') %>"><%- paginator({ prev_text: localText('pagination.prev'), next_text: localText('pagination.next') }) %></nav>
<% } %>
