<section class="section-header">
  <div>
    <h1><%= localText('search.title') %></h1>
    <p><%= localText('search.description') %></p>
  </div>
</section>
<section class="search-panel">
  <label class="search-label" for="search-input"><%= localText('search.label') %></label>
  <input id="search-input" class="search-input" type="search" placeholder="<%= localText('search.placeholder') %>" autocomplete="off">
</section>
<section id="search-results" class="search-results" data-search-url="<%= url_for('/search.json') %>">
  <p class="search-empty"><%= localText('search.start') %></p>
</section>
<noscript><p><%= localText('search.noScript') %> <a href="<%= url_for(localizedPath('posts')) %>"><%= localText('nav.posts') %></a></p></noscript>
<%- js('js/search.js') %>
